{
  "name": "sicherheitsfixer",
  "version": "0.3.0",
  "description": "Findet Sicherheitslücken in TypeScript-Projekten und schlägt geprüfte Korrekturen vor.",
  "type": "module",
  "bin": { "sicherheitsfixer": "dist/cli.js" },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": { "node": ">=20" },
  "keywords": ["security", "sast", "semgrep", "typescript", "auto-fix"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
